# The Inner Compass runtime config.
# All three are optional. The app runs correctly when they are unset.
# Copy to .env and fill in real values for staging. Never commit real values.

# GlitchTip / Sentry DSN for error tracking.
SENTRY_DSN=

# Umami analytics script URL (for example https://analytics.example.com/script.js).
UMAMI_URL=

# Umami website id for this app.
UMAMI_WEBSITE_ID=
